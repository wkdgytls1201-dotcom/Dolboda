generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FacilityType {
  NURSING_HOSPITAL
  NURSING_HOME
  DAY_NIGHT_CARE
  HOME_CARE
  SILVER_TOWN
}

enum DataSource {
  mock
  public
}

enum GradeSource {
  HIRA
  NHIS
}

// lib/types.ts의 Facility와 1:1 대응. 타입별로 다른 세부 필드(NursingHospitalExtra /
// NursingHomeExtra)는 컬럼을 나누지 않고 extra(jsonb)에 그대로 저장 — 기존 mockData.ts
// 객체를 거의 그대로 넣고 뺄 수 있게 하기 위함.
model Facility {
  id              String       @id
  name            String
  facilityType    FacilityType
  dataSource      DataSource
  gradeSource     GradeSource
  grade           Int?
  address         String
  lat             Float?
  lng             Float?
  phone           String?
  establishedYear Int?
  sourceUpdatedAt String
  parking         Json?
  extra           Json

  // 공단 일일 파일에서 처음 사라진 날(폐업 추정 시작일). 다시 나타나면 null로 복구된다 —
  // 하루 데이터 누락은 자동 치유. 7일 연속 사라지면 사이트맵 제외·noindex(폐업 "확정"은 아님 —
  // 이름+주소 해시 매칭이라 상호명 변경·이전도 여기 잡힌다). 행은 삭제하지 않는다(스냅샷·연결 보존).
  // 기간·지역별 폐업 집계: WHERE "missingSince" BETWEEN ... GROUP BY 주소 접두어.
  missingSince DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityType])
  @@index([dataSource])
  @@index([missingSince])
}

// 돌봄 합의서 — 보호자와 돌보다 매니저가 직접 맺는 합의의 기록.
//
// ★ 포지션: 돌보다는 이 합의의 당사자가 아니다. 표준 양식을 제공하고 서명 사실을
//   기록·보관할 뿐이며, 계약 내용과 이행 책임은 두 당사자에게 있다(약관과 동일한 입장).
//   이 선을 넘으면 직업안정법상 유료직업소개사업 등록 문제가 생긴다.
//
// 위변조 방지: 서명 시점의 합의 내용을 content(jsonb)에 통째로 박아두고 그 정규화
// 문자열의 SHA-256을 contentHash에 남긴다. 나중에 원본 돌봄 요청이 수정되더라도
// 서명된 합의서는 그대로 남고, 해시를 다시 계산해 대조하면 위변조가 드러난다.
// ★ 관계(@relation)를 일부러 걸지 않았다. User·CareRequest에 Cascade로 묶으면 한쪽이
//   탈퇴하는 순간 합의서가 사라지는데, 그러면 남은 당사자가 자기 권리를 증명할 자료를
//   잃는다. content에 서명 시점 내용이 통째로 들어 있어 원본 요청이 없어져도 문서는
//   온전하다. 보관 기간(3년)과 파기 조건은 개인정보처리방침 3항에 명시.
model CareAgreement {
  id              String @id @default(cuid())
  careRequestId   String @unique // 요청 한 건당 합의서 하나
  applicationId   String // 확정된 지원(= 어느 매니저와 맺은 합의인지)
  guardianId      String
  sitterProfileId String

  /**
   * 서명 시점에 확정된 합의 내용 전문(당사자·기간·업무범위·사례비 등)
   */
  content     Json
  /**
   * content의 정규화 JSON에 대한 SHA-256 — 위변조 대조용
   */
  contentHash String

  // 서명 기록 — 누가 언제 어떤 이름으로 동의했는지. 이미지 서명은 dataURL로 보관한다.
  // 서명 증거 — 전자서명은 "누가 서명했는지"를 다투게 되므로, 서명 순간의 정황을
  // 함께 남긴다(전자문서법상 작성자 확인 자료). 로그인 계정 + 서버 시각 + 접속 IP +
  // 기기 정보를 묶어두면 사후에 서명 사실을 설명할 수 있다.
  guardianName      String?
  guardianSignature String? // data:image/png;base64,...
  guardianSignedAt  DateTime?
  guardianSignedIp  String?
  guardianSignedUa  String?
  guardianEmail     String? // 서명 시점의 계정 이메일(사본 발송 대상)
  sitterName        String?
  sitterSignature   String?
  sitterSignedAt    DateTime?
  sitterSignedIp    String?
  sitterSignedUa    String?
  sitterEmail       String?

  /**
   * 양측 서명 완료 후 사본을 이메일로 보낸 시각
   */
  copySentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardianId])
  @@index([sitterProfileId])
}

// 돌봄일지 — 매니저와 보호자가 서로 확인하는 하루 기록. 설계: docs/care-log-spec.md
//
// 1단계는 "확인 일지"까지다(정산·근태 미연동, §3). 2단계에서 정산을 붙이게 되면
// workStart/workEnd가 그대로 근거가 되도록 지금부터 받아둔다(선택 항목으로).
//
// ★ CareAgreement와 같은 이유로 관계(@relation)를 걸지 않는다 — 보호자가 탈퇴해도
//   매니저의 작업 기록(경력·분쟁 대응 자료)은 남아야 한다. cascade로 묶으면 상대방
//   계정 삭제 한 번에 자기 기록이 통째로 사라진다.
model CareLog {
  id              String @id @default(cuid())
  careRequestId   String
  sitterProfileId String

  // 돌봄이 이루어진 날 (YYYY-MM-DD, KST). 매니저가 고르되 미래 날짜는 API에서 막는다.
  careDate String
  // 실제로 기록한 시각 — 서버가 찍는다. careDate와 차이가 크면 화면에 "N일 늦게 작성"으로 보여준다.
  createdAt DateTime @default(now())

  // --- 기본 3탭(이것만으로 저장된다) — 전부 nullable, 완벽을 요구하면 안 쓴다 ---
  meal      String? // "잘 드심" | "조금 드심" | "거의 못 드심"
  mood      String? // "좋으심" | "평소 같으심" | "힘들어하심"
  dayStatus String? // "별일 없었어요" | "알려드릴 일이 있어요"

  // --- 더 자세히(접힌 영역, 전부 선택) ---
  sleep      String?
  bowel      String?
  medication String?
  tasks      String[] // 오늘 한 일 칩 — 돌봄 요청의 업무 범위에서 화면이 자동 생성

  memo      String? // 오늘 한마디 — 보호자가 가장 좋아하는 부분
  alertNote String? // dayStatus가 "알려드릴 일이 있어요"일 때만 값이 있다. 값이 있으면 즉시 알림 발송.

  workStart String? // "09:00"
  workEnd   String? // "18:00"

  photos Json? // [{url, takenAt}] — 카메라 촬영만(클라이언트에서 강제), 선택

  readAt DateTime? // 보호자가 열람한 시각 — 매니저 쪽에 "확인했어요"로 표시

  // 보호자의 원탭 반응 — "thanks"(감사해요) | "relieved"(안심돼요) | "cheer"(수고하셨어요).
  // 읽음 확인의 다음 단계다: 매니저가 "읽혔다"를 넘어 "고마워한다"를 보는 것이
  // 감정노동의 보상이 된다(요양보호사 이탈의 큰 원인이 인정 부재 — 2026-08-05 조사).
  guardianReaction String?

  // 정정 기록 — 원본을 고치지 않고 새 행을 만들어 잇는다(append-only, 합의서와 같은 사상)
  correctsId String?

  @@index([careRequestId, careDate])
  @@index([sitterProfileId])
}

// 빠른 알림 — 돌봄 중에 버튼 하나로 그 자리에서 보내는 알림. CareLog와 분리한 이유는
// 일지는 하루에 하나지만 이건 하루에 여러 번 발생하고 발생 시각 자체가 정보이기 때문
// ("점심을 몇 시에 드셨나"). 이 기록들이 그날 CareLog 요약의 재료가 된다.
model CareQuickNote {
  id              String @id @default(cuid())
  careRequestId   String
  sitterProfileId String

  kind String // "meal" | "medication" | "walk" | "hospital" | "sleep" | "custom"
  body String? // kind가 "custom"일 때만("⚠️ 알려드릴 일이 있어요")

  careDate  String // YYYY-MM-DD(KST) — 일지와 묶는 키
  createdAt DateTime @default(now())

  // 1분 안에 취소하면 지우지 않고 표시만 한다 — 보호자가 이미 봤을 수 있어
  // 조용히 사라지면 "내가 잘못 봤나" 싶게 된다
  canceledAt DateTime?
  readAt     DateTime?

  @@index([careRequestId, careDate])
}

// 돌봄일지 정기 체크인 알림의 쿨다운 기록. 요청 하나당 한 행만 두고 sentAt만 계속
// 갱신한다(AlertDelivery처럼 날짜별로 쌓지 않는다 — 이건 "오늘 보냈나"가 아니라
// "최근 며칠 안에 보냈나"만 알면 되는 쿨다운이라 더 단순하게 간다).
// scripts/send-care-log-reminders.mjs 참고.
model CareLogReminder {
  careRequestId String    @id
  sentAt        DateTime  @default(now())
}

// "지원자 없는 요청 넛지"(alert-system-spec §3-14)의 발송 기록 — 요청당 평생 한 번만
// 보낸다(반복하면 잔소리가 된다). 보호자는 진행 중 요청이 1건뿐이라(advisory lock)
// "사람당 한 통" 원칙도 자연히 지켜진다. scripts/send-open-request-nudges.mjs 참고.
model OpenRequestNudge {
  careRequestId String   @id
  sentAt        DateTime @default(now())
}

// 돌봄일지 가족 공유(care-log-spec §9-5) — 보호자가 초대 링크를 만들고, 가족이
// 로그인 후 수락하면 읽기 전용 열람이 열린다. 비로그인 링크를 쓰지 않는 이유:
// 일지는 식사·배변·복약이 담긴 민감정보라 "누가 보는지"가 남아야 하고, 보호자가
// 언제든 해제(revokedAt)할 수 있어야 한다. 삭제 대신 revokedAt을 쓰는 것도 같은
// 이유 — 언제 누구에게 열람을 줬다 거뒀는지가 기록으로 남는다.
// 돌봄 포인트 원장(docs/points-spec.md) — 잔액은 이 표의 합이다(별도 잔액 컬럼 없음 —
// 원장과 잔액이 어긋날 수 없다). 현금·상품권 교환이 불가능한 플랫폼 내 리워드라
// 선불전자지급수단이 아니고, 적립 명목은 근무 대가가 아니라 "보호자의 감사·후기에
// 대한 플랫폼 리워드"다(매니저 법적 거리 방침). 같은 사건 중복 지급은 유니크가 막는다.
model PointLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // 적립 +, 사용 -
  kind      String // review_received | review_five_star | reaction | review_written | spend_ribbon | spend_request_boost
  refId     String   @default("") // 사건의 근원(careRequestId·careLogId) — 사용 건은 고유 난수
  memo      String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, createdAt])
}

// 추천인 코드(points-spec §5 2단계) — 사용자당 1개, 잃어버릴 일 없게 지연 생성.
model ReferralCode {
  userId    String   @id
  code      String   @unique // 8자 대문자·숫자(혼동 문자 제외)
  createdAt DateTime @default(now())
}

// 추천 귀속 — 가입자당 1회. 보상은 가입 시점이 아니라 "귀속된 사람이 첫 돌봄을
// 완료했을 때" 양쪽 지급(rewardedAt) — 가입만으로 주면 유령 계정 어뷰징 통로가 된다.
model ReferralAttribution {
  userId     String    @id // 초대받은 사람(신규 가입자)
  referrerId String // 초대한 사람
  createdAt  DateTime  @default(now())
  rewardedAt DateTime? // 첫 돌봄 완료 보상 지급 시각(null = 아직)

  @@index([referrerId])
}

model CareLogFamilyAccess {
  id            String    @id @default(cuid())
  careRequestId String
  token         String    @unique // 초대 링크 토큰(수락 전까지만 의미)
  userId        String? // 수락한 가족 계정(수락 전 null)
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  revokedAt     DateTime?

  @@index([careRequestId])
  @@index([userId])
}

// 시설 시계열 스냅샷 — 매일 새벽 공단 데이터를 자동 수집(scripts/daily-nhis-sync.mjs)하면서
// 정원·현원·대기·등급이 "바뀐 시설만" 그날 값으로 적재한다(첫 실행일은 전체 기준선).
// 쌓이면: 자리 난 시설 감지 → 찜한 시설 알림 → 대기 소진 속도 → 등급 변동 추적의 재료가 된다.
// 어제 값이 필요하면 그 시설의 date <= 조회일 중 가장 최근 행을 읽으면 된다(변경분만 저장하므로).
model FacilitySnapshot {
  id               BigInt @id @default(autoincrement())
  facilityId       String
  date             String // YYYY-MM-DD (KST 기준 수집일)
  capacity         Int
  currentOccupancy Int
  waitlistCount    Int
  grade            Int?

  @@unique([facilityId, date])
  @@index([date])
}

// 장기요양기관 업체 마스터 — 공단 "전국 장기요양기관 상세정보" 파일(11개 시트)을 병합한 원본.
// 한 기관(instCode)이 방문요양·방문목욕·주야간보호처럼 급여종류별로 여러 행을 가진다.
// Facility.extra를 채우는 소스이자, 나중에 업체 가입·프리미엄 노출과 연결할 기준 데이터.
// data(jsonb) 구조: { basic, capacity, staff, staffHomecare, tenure, rooms, dementiaUnits,
//                    nonCoveredFees, programs } — scripts/import-institutions.mjs 참고
model Institution {
  id          String  @id // `${instCode}-${serviceCode}`
  instCode    String // 공단 기관번호 (장기요양기관기호)
  name        String
  sido        String
  serviceCode String // 급여종류코드 (A03 등)
  serviceName String // 급여종류 (노인요양시설 등)
  address     String
  phone       String?
  data        Json
  sourceDate  String // 파일의 최종변경일

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instCode])
  @@index([name])
  @@index([serviceCode])
}

// 상담 문의 전달 수신거부 목록.
//
// 시설 이메일은 공단이 행정 목적으로 공개한 주소라 마케팅 수신 동의를 받은 적이 없다.
// "그만 보내달라"는 의사를 받으면 즉시, 그리고 영구히 지켜야 한다 —
// 사람이 기억해서 빼는 방식은 언젠가 반드시 새어나간다.
//
// 이메일 주소를 키로 잡는다(시설 id가 아니라). 한 법인이 여러 시설에 같은 주소를 쓰는
// 경우가 있어서, 주소 기준으로 막아야 "다른 시설로 또 왔다"는 일이 안 생긴다.
model EmailOptOut {
  email        String   @id // 소문자로 정규화해 저장
  facilityId   String? // 요청이 들어온 시점의 시설(참고용)
  facilityName String?
  // "one-click"(메일 헤더 버튼) / "manual"(회신을 보고 운영자가 등록)
  source       String
  createdAt    DateTime @default(now())
}

// 시설 운영자의 입점·제휴 신청 접수함 (/business).
//
// 보호자가 넣는 ConsultRequest와 성격이 완전히 다르다 — 이쪽은 B2B 리드다.
// 신청 단계에서는 최소한만 받는다(시설 식별 + 담당자 연락처). 서류·계좌 같은 건
// 이메일로 안내한 뒤 회신받는다(전화 없음 — 운영 방침). 처음부터 다 받으면
// 신청 자체가 뚝 떨어지고, 우리도 아직 검증되지 않은 개인정보를 떠안게 된다.
model BusinessInquiry {
  id           String  @id @default(cuid())
  facilityName String
  // 공단 기관기호(11자리)와 사업자등록번호(10자리) 중 시설이 아는 쪽으로 받는다.
  // 어느 쪽 번호인지 함께 저장해야 운영자가 조회할 곳을 안다.
  registryType String // "instCode" | "bizNo"
  registryNo   String
  // 우리 DB의 Facility와 이어졌으면 그 id (신청서에서 시설을 특정한 경우).
  // 관계를 걸지 않는 건 의도다 — 시설 데이터가 재적재로 갈려도 신청 기록은 남아야 한다.
  facilityId   String?

  managerName String
  managerRole String?
  phone       String
  email       String

  // lib/businessPlans.ts의 plan id. 가격은 여기 저장하지 않는다 —
  // 요금이 바뀌면 과거 신청서의 숫자까지 소급돼 보이는 게 더 위험하다.
  plan    String
  message String?

  // 마케팅 정보 수신 동의(선택). 언제 동의했는지가 법적으로 중요해서 시각으로 저장한다
  // (null = 동의 안 함). 광고성 정보를 보내려면 이 값이 있는 신청자에게만 보낼 것.
  marketingConsentAt DateTime?

  // 운영자 처리 상태: null=접수 / "contacted"=서류 안내 발송 / "verified"=승인 / "rejected"
  // ("contacted"는 예전 절차의 키 이름을 그대로 쓴다 — 쌓인 데이터와의 호환을 위해 유지한다)
  status String?
  // 운영자 내부 메모 (시설에는 보이지 않는다)
  memo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// 상담 신청 접수함 — 관리자 목록 + 접수 시 이메일 발송(lib/resend.ts).
// 리드 파이프는 회사가 쥔다: 시설로 자동 전달되지 않고, 운영자를 거쳐야만 시설에 닿는다
// (나중에 리드 과금·프리미엄 노출 같은 B2B 수익화의 기반이 되는 관문).
model ConsultRequest {
  id                 String    @id @default(cuid())
  facilityId         String
  facilityName       String
  name               String
  phone              String
  // 로그인 상태로 신청하면 계정과 연결 — 마이페이지 "상담 내역"의 근거.
  // 비로그인 신청도 받아야 하므로 널 허용. 계정 삭제 시 연결만 끊는다(SetNull) —
  // 상담 기록 자체는 운영 리드라 유지하되, 누구 것인지는 잊는다.
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 보호자가 "어르신 정보 함께 전달"에 체크한 경우에만 저장되는 프로필 요약 스냅샷(구간값).
  // 원본 CareProfile을 참조하지 않고 신청 시점 값을 복사한다 — 이후 프로필을 지워도
  // 이미 전달된 상담 내용은 신청 당시 그대로 남아야 운영자·시설과의 대화가 안 꼬인다.
  profileSummary     Json?
  // 보호자 본인이 표시하는 진행 상태: 연락받음 / 입소결정 (null = 대기)
  status             String?
  // 시설에 자동 이메일 발송이 성공한 시각 (null = 이메일 정보가 없거나 발송 실패 —
  // 이 경우 운영자가 직접 연락해야 한다는 신호). 상담 이력 화면에서 "안내 완료" 표시에 쓴다.
  facilityNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// 복지용구 상담 신청 — ConsultRequest(시설)와 같은 성격의 리드지만 대상이 다르다.
// 복지용구 사업소(Institution)는 이메일이 없어(전화번호만 100% 보유) 시설처럼
// 자동 이메일 전달을 할 수 없다 — 그래서 운영자가 텔레그램·메일 알림을 받아
// 신청자에게 직접 연락하거나 가까운 사업소로 안내하는 수동 처리 구조다.
model WelfareConsultRequest {
  id      String @id @default(cuid())
  name    String
  phone   String
  sido    String // 시/도 라벨 (예: 경남)
  sigungu String // 시/군/구 (예: 김해시)
  items   Json // 관심 품목명 배열(String[]) — 스키마 변경 없이 품목 목록을 늘릴 수 있게 Json으로 둔다

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 보호자 본인이 표시하는 진행 상태 셀프 체크(연락받음). null = 대기
  status String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// 아래 4개는 @auth/prisma-adapter(NextAuth) 표준 스키마 그대로
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  // 가입 시각(2026-08-05 추가) — 추천 귀속의 "신규 회원" 판정 등에 쓴다.
  // ⚠️ 추가 시점의 기존 회원들은 default(now())로 이 날짜가 찍혔다(실제 가입일 아님).
  createdAt              DateTime                @default(now())
  accounts               Account[]
  sessions               Session[]
  sitterProfile          SitterProfile?
  careRequests           CareRequest[]
  careProfiles           CareProfile[]
  consultRequests        ConsultRequest[]
  welfareConsultRequests WelfareConsultRequest[]
  facilityOwners         FacilityOwner[]
  facilityFavorites      FacilityFavorite[]
  regionInterests        RegionInterest[]
  savedSearches          SavedSearch[]
  sitterNotificationPref SitterNotificationPref?
}

// 관심시설(찜) + 그 시설에 대한 알림 설정.
//
// 예전엔 둘 다 localStorage에만 있었다(mosim-favorite-ids / mosim-alert-prefs).
// 그래서 (1) 기기를 바꾸면 찜이 사라졌고 (2) 서버가 수신자를 몰라 알림을 보낼 수 없었다.
// 일일 수집(scripts/daily-nhis-sync.mjs)이 빈자리·등급 변동을 이미 매일 감지하고 있는데도
// 보낼 대상이 없어 로그만 찍고 버리던 상태였다. 설계는 docs/favorite-alert-spec.md.
//
// 찜과 알림 설정을 한 행에 두는 이유: 화면(app/notifications)이 "찜한 시설에만 알림을
// 걸 수 있다"는 구조라 찜 없이 알림만 있는 상태가 없다. 나누면 항상 조인해야 하고
// 찜을 지울 때 고아 행이 남는다.
model FacilityFavorite {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String

  // 알림 스위치 — 기본은 둘 다 꺼둔다(찜은 "저장"이지 "알림 신청"이 아니다)
  vacancyAlert     Boolean @default(false)
  gradeChangeAlert Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, facilityId])
  // 알림 발송은 사용자가 아니라 시설에서 출발한다("이 시설에 자리가 났다 → 누구에게 보낼까")
  @@index([facilityId, vacancyAlert])
  @@index([userId])
}

// 보낸 알림 기록 — 같은 사건을 두 번 보내지 않기 위한 것이자 발송 이력이다.
//
// ⚠️ 이 표가 없으면 수집이 재실행될 때(수동 재시도·부분 실패 복구) 같은 알림이 다시 나간다.
// 알림은 되돌릴 수 없으므로 중복 방지는 선택이 아니다.
//
// @@unique([userId, facilityId, kind, date])가 그 자체로 잠금 역할을 한다 —
// 발송 전에 create를 시도해서 성공한 건만 실제로 보낸다(중복이면 P2002로 걸린다).
model AlertDelivery {
  id         String @id @default(cuid())
  userId     String
  facilityId String
  // "vacancy" | "gradeChange"
  kind       String
  // 사건이 감지된 수집일 (YYYY-MM-DD, KST) — 하루 한 사건당 한 번만 보낸다
  date       String
  // "email" | "push"
  channel    String

  // 발송 성공 시각. null이면 시도했지만 실패한 것 —
  // 행은 남겨 재시도 때 같은 사람에게 또 보내지 않게 한다.
  sentAt DateTime?
  // 실패 사유(운영자가 원인을 볼 수 있게)
  error  String?

  createdAt DateTime @default(now())

  @@unique([userId, facilityId, kind, date])
  @@index([createdAt])
}

// 관심 지역 — 시설과 달리 대상이 특정되지 않아 별도 테이블로 둔다.
model RegionInterest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // lib/regions.ts의 REGIONS 표기(예: "경남"). regionSeo.ts의 REGION_SEO와는 다른
  // 표(전남·광주를 합치는지 여부)라 혼동하지 말 것 — 한 번 뒤섞여서 "전남"·"광주"
  // 저장이 조용히 실패하는 버그가 났었다.
  region String

  createdAt DateTime @default(now())

  @@unique([userId, region])
  @@index([region])
}

// 저장한 검색 조건 — 다시 방문 안 해도 조건에 맞는 새 시설이 뜨면 알려준다.
// FacilityFilters(components/FilterBar.tsx)를 그대로 JSON으로 저장한다. 매칭(발송
// 스크립트)은 위치·안심지수처럼 계산이 필요하거나 서버에 저장 안 된 조건은 보고
// 판단하지 않는다 — maxDistanceKm(사용자 위치를 서버에 안 둔다)과 goodScoreOnly
// (안심지수는 즉석 계산이라 순수 node 스크립트에서 값싸게 재현 못 한다)는 저장은
// 해두되 매칭에서는 건너뛴다. scripts/send-facility-alerts.mjs 참고.
model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 사람이 읽는 요약 — 알림 메일·목록에 그대로 쓴다("요양원 · 3등급 이상 · 빈자리만")
  label   String
  filters Json

  createdAt DateTime @default(now())

  @@index([userId])
}

// 시설 담당자 ↔ 계정 연결. 운영자가 서류 확인을 마치고 승인했을 때만 생긴다.
//
// 이 행이 있어야 시설 콘솔(/business/console)에 들어갈 수 있다. 즉 "누가 이 시설을
// 수정할 수 있는가"의 유일한 근거다. 화면에서 버튼을 숨기는 것으로는 막히지 않으므로,
// 시설 정보를 바꾸는 API는 전부 이 행을 조회해서 확인한다.
model FacilityOwner {
  id         String @id @default(cuid())
  facilityId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 신청서에 적힌 담당자 정보(승인 시점 스냅샷) — 나중에 담당자가 바뀌어도
  // "누구를 확인하고 승인했는지"가 남아야 분쟁 때 근거가 된다.
  managerName String
  managerRole String?
  phone       String
  email       String

  // 승인한 운영자와 시각. 어떤 근거로 승인했는지는 memo에 남긴다.
  approvedBy String?
  memo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 한 시설에 여러 담당자를 붙일 수 있게 하되, 같은 사람이 두 번 붙지는 않게 한다
  @@unique([facilityId, userId])
  @@index([facilityId])
  @@index([userId])
}

// 시설의 유료 구독. lib/businessPlans.ts의 plan id를 쓴다.
//
// monthlyPrice를 여기에 복사해 두는 게 의도다 — 나중에 요금표를 바꿔도
// 이미 계약한 시설의 청구 금액이 소급해서 달라지면 안 된다.
model FacilitySubscription {
  id         String @id @default(cuid())
  facilityId String
  plan       String // "plus" | "sponsor" | "premium" | "silvertown"

  // "active" | "pending"(입금 대기) | "paused" | "cancelled"
  status       String @default("pending")
  monthlyPrice Int // 계약 시점 금액(원, 부가세 별도)

  startedAt DateTime  @default(now())
  // null이면 기한 없이 계속. 해지하면 그 달 말일이 들어간다.
  endsAt    DateTime?

  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([status])
}

// 시설이 콘솔에서 직접 작성하는 콘텐츠 (소개글·사진).
//
// Facility.extra(jsonb)에 넣지 않는 건 의도다 — extra는 공단 일일 수집이 소유한 영역이라
// 재적재·갱신 과정에서 시설이 쓴 내용이 덮이거나 꼬일 수 있다. 시설 작성분은 여기 격리한다.
// 사진 URL은 Supabase Storage 공개 버킷(facility-photos)을 가리킨다.
model FacilityContent {
  facilityId String   @id
  intro      String? // 시설이 쓴 소개글 (최대 2,000자 — API에서 자름)
  photos     Json     @default("[]") // string[] — 업로드 순서 유지
  updatedBy  String? // 마지막으로 수정한 userId (분쟁 시 근거)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// 시설 소식 (비즈니스 플러스 이상). 행사·공지·채용 같은 짧은 글.
//
// FacilityContent(소개글)와 분리한 이유: 소개글은 시설당 1개를 덮어쓰는 값이고
// 소식은 쌓이는 목록이라 수명이 다르다. 상세 페이지에는 최신 몇 개만 싣는다.
model FacilityPost {
  id         String   @id @default(cuid())
  facilityId String
  title      String // 최대 80자 — API에서 자름
  body       String // 최대 1,000자
  createdBy  String // 작성한 userId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([facilityId, createdAt])
}

// 시설 상세 페이지 일일 조회수. 상세 방문 시 클라이언트 비컨이 하루 단위로 +1 한다.
// 개인 식별 정보는 아무것도 없다 — 시설별 날짜별 합계뿐이다.
model FacilityDailyView {
  facilityId String
  date       DateTime @db.Date
  count      Int      @default(0)

  @@id([facilityId, date])
}

// 스폰서·배너 노출/클릭 일별 집계. FacilityDailyView와 같은 설계다 —
// 이벤트를 행마다 쌓지 않고 (시설, 종류, 날짜) 하나로 뭉쳐 카운터만 올린다.
//
// kind는 "sponsor_impression" | "sponsor_click" | "banner_impression" | "banner_click".
// 이 데이터가 없으면 월간 성과 보고서의 "노출·클릭"이 요금제 설명(businessPlans.ts)과
// 어긋난 빈 약속이 된다 — 보고서를 만들기 전에 먼저 채워야 하는 테이블.
model AdEvent {
  facilityId String
  kind       String
  date       DateTime @db.Date
  count      Int      @default(0)

  @@id([facilityId, kind, date])
}

// 시설 담당자의 정보 정정 요청 (콘솔에서 접수).
// 운영자가 확인 후 반영한다 — 시설이 공공데이터 원본을 직접 고치게 하면 안 된다.
model FacilityCorrection {
  id         String   @id @default(cuid())
  facilityId String
  message    String // 무엇이 어떻게 다른지 (최대 1,000자)
  createdBy  String // 요청한 userId
  // null=접수 / "done"=반영 완료 / "rejected"=반영 불가
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([facilityId])
  @@index([status])
}

// 지역 배너 — 지역 프리미엄 이상 전용, 시·군·구당 1곳(SponsorPlacement의 3곳보다 희소).
//
// SponsorPlacement와 같은 regionKey를 쓰지만 별도 모델이다: 배너는 이미지 콘텐츠가
// 있어야 성립하고(스폰서는 카드 정보만 재사용), 상한도 다르다(1 vs 3).
// facilityId를 PK로 둔 이유는 시설당 배너가 하나뿐이면 충분하고, 소유권 조회가
// FacilityOwner처럼 간단한 upsert 하나로 끝나기 때문이다.
model FacilityBanner {
  facilityId String  @id
  regionKey  String
  imageUrl   String?
  // 구독 확인 전까지는 false — SponsorPlacement.active와 같은 규칙(입금 확인 후 admin이 켠다)
  active     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionKey, active])
}

// 지역 스폰서 노출 슬롯.
//
// 구독과 따로 두는 이유: 한 시설이 여러 지역을 살 수도 있고, 같은 지역을 두 시설이
// 나눠 가질 수도 있어서 1:1로 묶이지 않는다. 지역당 판매 수 상한
// (businessPlans.ts의 SPONSOR_SLOTS_PER_SIGUNGU)은 이 표를 세서 지킨다.
model SponsorPlacement {
  id         String @id @default(cuid())
  facilityId String

  // "sigungu" | "sido" | "national"
  scope     String
  // scope=sigungu면 "경남 김해시", sido면 "경남", national이면 빈 문자열.
  // 검색 화면이 지역을 문자열로 다루므로 코드가 아니라 표기를 그대로 저장한다.
  regionKey String

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, regionKey, active])
  @@index([facilityId])
}

// 보호자가 저장해두는 "어르신 돌봄 프로필" — 검색 개인화·돌봄 요청 자동 채움에 재사용한다.
//
// 민감정보(건강 상태) 최소 수집 원칙:
//  - 이름·주민번호는 아예 받지 않는다. 호칭(어머니 등)이 이름을 대신한다.
//    ⚠️ 생년월일은 2026-08-03 사용자 결정으로 예외가 됐다 — 요양인정번호 등록 화면에서만
//    받고(birthDate), 그 외 화면은 여전히 연령대 구간(ageBand)만 쓴다.
//    수집 항목이 늘었으므로 app/privacy/page.tsx도 함께 갱신해야 한다.
//  - 전부 구간값(연령대·체중대·상태 단계)만 받는다 — CareRequest의 recipient 필드와 같은 선택지.
//  - consentAt(민감정보 수집·이용 동의 시각)이 필수라, 동의 없는 저장은 스키마 수준에서 불가능.
//  - 보호자가 언제든 삭제할 수 있고, 회원 탈퇴 시 함께 삭제된다(Cascade).
model CareProfile {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation String // 어르신과의 관계 호칭 (어머니/아버지 등) — 프로필 이름 역할

  gender            String?
  ageBand           String?
  weightBand        String?
  mobilityLevel     String?
  mealAssistLevel   String?
  toiletAssistLevel String?
  conditions        String[] // 질환·상태 (치매·인지저하 등, 선택지 기반)

  // 실제 장기요양등급 (본인 신고값) — "없음/신청 준비 중/1~5등급/인지지원등급"
  ltcGrade         String?
  // 요양인정번호(공단 발급) — 본인 신고값이며 공단 실시간 조회와 연동돼 있지 않다.
  // 복지용구 혜택 화면(마이페이지)에서 "등록"만 하고, 남은 한도 같은 실제 급여 현황은
  // 이 번호로 조회하지 않는다 — 화면에 "정보 확인용"이라고 항상 밝힐 것.
  ltcCertNumber    String?
  // 어르신 생년월일 (YYYY-MM-DD). 요양인정번호 등록 화면에서만 받는다.
  birthDate        String?
  // 장기요양 인정유효기간 시작일 (YYYY-MM-DD). 인정서에 적힌 값을 그대로 옮겨 적는 것이며
  // 만료일을 우리가 계산하지는 않는다 — 갱신 주기가 등급·판정에 따라 달라서 추정하면 틀린다.
  ltcCertValidFrom String?
  // 등급테스트 추정 구간 — 실제 등급이 아니므로 화면에서 항상 "예상"으로 구분 표시
  estimatedBand    String?
  estimatedAt      DateTime?

  consentAt DateTime // 민감정보(건강정보) 수집·이용 동의 시각
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 등급테스트 재검사 리마인드 알림의 쿨다운 기록 — CareLogReminder와 같은 설계
// (프로필 하나당 한 행, sentAt만 계속 갱신). scripts/send-grade-test-reminders.mjs 참고.
model GradeTestReminder {
  careProfileId String   @id
  sentAt        DateTime @default(now())
}

// 로그인한 보호자가 마이페이지에서 옵트인으로 추가하는 "모심시터" 프로필.
// User와 별개 테이블로 둬서, 시터가 아닌 일반 회원에겐 아무 영향이 없다.
model SitterProfile {
  id                String                   @id @default(cuid())
  userId            String                   @unique
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname          String
  photoUrl          String?
  nationality       String
  intro             String?
  experienceYears   Int                      @default(0)
  regions           String[] // 활동 가능 지역(시/도 단위), 최대 10개
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  agreedAt          DateTime // 필수 약관 동의 시각
  marketingOptIn    Boolean                  @default(false)
  // 공개 프로필(/manager/[id]) 동의 시각 — null이면 비공개(기본).
  // 매니저가 프로필 관리에서 직접 켠 시각을 남긴다(공개 동의의 근거 기록).
  // 보호자용으로 쓴 프로필을 동의 없이 오픈웹에 내지 않기 위한 옵트인 스위치다.
  publicProfileAt   DateTime?
  // 역경매 지원자 카드용(2026-08-05) — 보호자가 선호 성별을 지정하는데 정작 지원자
  // 성별을 알 길이 없었다. 매니저가 직접 입력하는 선택 항목(밴드형 — 정확 나이는 안 받음).
  gender            String? // "여성" | "남성"
  ageBand           String? // "20대" ~ "70대 이상"
  // 돌봄 스타 별(포인트 사용처) 만료 시각 — 지원자 카드·공개 프로필 ⭐ 표시 +
  // 지원자 목록에서 활성자 우선 노출(그 안은 선착순 — 2026-08-06 사용자 결정)
  ribbonUntil       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  certifications    SitterCertification[]
  applications      CareRequestApplication[]
  reviews           CareReview[]
}

model SitterCertification {
  id              String        @id @default(cuid())
  sitterProfileId String
  sitterProfile   SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  name            String
  issuedBy        String?
  createdAt       DateTime      @default(now())
}

// "새 일자리 알림"을 누구에게 이미 보냈는지 기록한다. 이게 없으면 알림 스크립트를
// 두 번 돌렸을 때(예: 실패해서 재시도) 같은 사람에게 같은 공고를 두 번 보내게 된다.
//
// @@id([userId, careRequestId])로 "이 사람 + 이 공고" 조합을 기본 키로 삼았다. 데이터베이스가
// 같은 조합을 두 번 저장하지 못하게 막아주므로("unique 제약"), 우리 코드가 직접
// "이미 보냈는지 확인 → 없으면 보내기"를 두 단계로 나눠 할 필요가 없다. 그냥 저장을
// 시도했다가 실패하면(이미 있으면) "아, 이미 보냈구나"로 해석하면 된다 —
// scripts/send-facility-alerts.mjs의 AlertDelivery가 쓰는 것과 같은 요령이다.
model SitterJobAlertDelivery {
  userId        String
  careRequestId String
  sentAt        DateTime? // 성공 시각. null이면 시도했지만 아직 실패한 상태
  error         String? // 실패 사유
  createdAt     DateTime  @default(now())

  @@id([userId, careRequestId])
}

// 매니저(돌보다 매니저 = 시터)가 어떤 알림을 받을지 고르는 설정.
//
// ★ 왜 이 표가 필요한가: 예전에는 이 설정이 브라우저의 localStorage에만 저장됐다.
// localStorage는 "그 브라우저, 그 기기에만" 남는 저장 공간이라 서버(우리 데이터베이스)는
// 전혀 알 수 없다. 그래서 알림을 실제로 보내는 프로그램(scripts/*.mjs, 매일 새벽 자동
// 실행됨)이 "누가 알림을 켜뒀는지" 자체를 조회할 방법이 없었다 — 화면에는 스위치가
// 켜져 있어도 실제로는 아무에게도 메일이 안 나가는 상태였다는 뜻이다.
// 보호자 쪽 찜 알림(FacilityFavorite 모델)을 이미 서버로 옮겨서 잘 쓰고 있는데, 매니저
// 쪽은 아직 이 작업을 안 해서 새 알림 기능(예: "일하기 좋은 시설이 새로 생겼어요")을
// 못 붙이고 있었다. 이 표를 만들어서 같은 방식으로 옮긴다.
//
// userId를 그대로 기본 키(@id)로 쓴 이유: 사람 한 명당 알림 설정은 딱 하나면 되기
// 때문이다(SitterProfile처럼 별도 id를 만들 필요가 없다). 이렇게 하면
// "이 사람의 설정을 가져와줘"를 userId 하나로 바로 조회할 수 있다.
model SitterNotificationPref {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 내 활동 지역(SitterProfile.regions)에 새 돌봄 일자리가 올라오면 알림
  newJob Boolean @default(true)
  // 내가 지원한 일자리에 진행 상황(매칭 확정/미선정 등)이 생기면 알림
  matchUpdate Boolean @default(true)

  updatedAt DateTime @updatedAt
}

enum CareRequestStatus {
  OPEN // 등록됨, 지원 받는 중
  MATCHED // 지원자 중 확정
  CANCELLED // 보호자가 취소
  COMPLETED // 돌봄 종료
}

enum CareLocationType {
  HOSPITAL // 병원
  HOUSEKEEPING // 가사돌봄
  HOME // 집에서(자택, 병원 아님)
}

// 보호자가 등록하는 돌봄 요청 — 활동지역이 겹치는 모심시터가 마이페이지 "일자리 관리"에서
// 보고 지원할 수 있다. 결제/가격 산정 인프라가 없어 금액 관련 필드는 의도적으로 없음.
model CareRequest {
  id           String            @id @default(cuid())
  guardianId   String
  guardian     User              @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  status       CareRequestStatus @default(OPEN)
  locationType CareLocationType  @default(HOSPITAL)

  region        String // 시/도 — lib/regions.ts REGIONS 값 중 하나
  locationNote  String?
  startDate     DateTime
  endDate       DateTime
  startTime     String? // "09:00" 형식. 24시간 종일제면 비움
  endTime       String?
  roundTheClock Boolean  @default(false) // 24시간 상주 돌봄

  // 돌봄 받으실 분 — 시터가 업무 강도를 가늠하는 데 쓰는 최소 정보.
  // 이름은 성(姓)만 받아 개인정보를 최소화한다.
  recipientName       String?
  recipientRelation   String? // 신청자와의 관계
  recipientGender     String?
  recipientAgeBand    String? // 연령대(예: "70대")
  recipientWeightBand String? // 체중대 — 이동·부축 난이도와 직결

  situation         String?
  mobilityLevel     String?
  mealAssistLevel   String? // 식사 보조 수준(스스로 가능/부분 도움/전적 도움 …)
  toiletAssistLevel String? // 배변 보조 수준
  needsMealAssist   Boolean  @default(false) // 구버전 호환용 요약 플래그
  needsToiletAssist Boolean  @default(false)
  conditions        String[]
  householdTasks    String[] // 가사돌봄일 때 체크리스트 (lib/householdTasks.ts)
  visitsPerWeek     Int? // 가사돌봄/집에서처럼 방문 단위일 때(선택)
  visitHours        Int? // 1회 방문 시간(선택)

  // 병원 간병일 때만 쓰는 입원 관련 정보
  hospitalEntry   String? // 병원 출입 절차
  roomType        String? // 병실 종류
  admissionReason String? // 입원 사유
  surgeryPlan     String? // 입원 중 수술 예정 여부

  sitterGenderPref String   @default("무관")
  specialRequests  String[] // 특별 요청(복수 선택)
  requestNote      String?

  // 보호자가 직접 적는 희망 사례비. 우리가 계산하거나 중개하지 않고 그대로 전달만 한다.
  budgetAmount Int?
  budgetUnit   String? // "일" | "시간"

  completedAt DateTime?

  // 우선 요청(포인트 사용처) 만료 시각 — 일자리 목록 상단 고정 + 배지 표시
  boostUntil DateTime?

  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  applications CareRequestApplication[]
  review       CareReview?

  @@index([status, region])
}

// status 흐름: 지원완료 → 매칭확정 → 돌봄완료
//                        ↘ 미선정 (다른 지원자가 확정되는 순간 일괄 처리 —
//                          무소식으로 방치하는 것이 매니저 이탈의 가장 큰 원인이라
//                          떨어진 것도 반드시 알린다)
model CareRequestApplication {
  id              String        @id @default(cuid())
  careRequestId   String
  careRequest     CareRequest   @relation(fields: [careRequestId], references: [id], onDelete: Cascade)
  sitterProfileId String
  sitterProfile   SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  status          String        @default("지원완료")
  createdAt       DateTime      @default(now())

  // 역경매(2026-08-05) — 매니저가 지원하며 제시하는 사례비와 한마디(둘 다 선택).
  // 단위는 지원 "시점"의 요청 단위를 고정 저장한다 — 요청이 OPEN인 동안 보호자가
  // 단위를 바꿔도 이미 들어온 제안의 뜻이 뒤바뀌지 않게.
  proposedAmount Int?
  proposedUnit   String? // "시간" | "일"
  message        String? // 지원 한마디 (200자)

  @@unique([careRequestId, sitterProfileId])
}

// 완료된 돌봄에 보호자가 남기는 후기 — 매니저의 "돌보다 인증 경력"이 되는 데이터.
// 요청당 1건(unique), 확정됐던 매니저에게만 남길 수 있다(API에서 검증).
// 별점 + 짧은 한줄평만 받는다. 지원자 카드의 "완료 N건 · ★4.8"이 여기서 나온다.
model CareReview {
  id              String        @id @default(cuid())
  careRequestId   String        @unique
  careRequest     CareRequest   @relation(fields: [careRequestId], references: [id], onDelete: Cascade)
  sitterProfileId String
  sitterProfile   SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  rating          Int // 1~5
  comment         String?
  createdAt       DateTime      @default(now())

  @@index([sitterProfileId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
